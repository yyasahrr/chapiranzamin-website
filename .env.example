# Optional override for uploads and other writable app data.
APP_DATA_DIR=

# PHP API used by every Next.js route handler. Do not configure a database URL
# in the Next.js/Vercel project; database access belongs to the PHP backend.
PHP_API_BASE_URL=http://localhost:8080

# The first admin is created only when the database has no admin.
# On Vercel preview deployments these can be added later, but admin login stays unavailable until set.
ADMIN_NAME=مدیر سیستم
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Development may use false. Production cookies are always Secure.
COOKIE_SECURE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to production only after NEXT_PUBLIC_SITE_URL is the final HTTPS domain.
SITE_ENV=development

# OTP: production requires a random secret of at least 32 characters.
# Development returns the code in the UI unless OTP_DEV_MODE=false.
OTP_SECRET=
OTP_DEV_MODE=true
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_OTP_TEMPLATE=chapiranzamin_otp

# Payment gateway adapter. "mock" is for local development only.
# A real gateway can be connected through create/verify webhook endpoints.
PAYMENT_PROVIDER=mock
PAYMENT_ALLOW_MOCK=false
PAYMENT_CREATE_URL=
PAYMENT_VERIFY_URL=
PAYMENT_API_KEY=

# Footer social links (optional).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Bulk email. Sending stays disabled until explicitly enabled.
EMAIL_SEND_ENABLED=false
EMAIL_FROM_NAME=چاپخانه
EMAIL_FROM_ADDRESS=
EMAIL_MAX_RECIPIENTS=200
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
