# mysql (production) or sqlite (local dev / preview without a DB server)
DB_DRIVER=mysql

# MySQL settings (used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_NAME=chapiran_php
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SQLite settings (used when DB_DRIVER=sqlite). Relative paths resolve from
# the php-backend/ directory; the wasm dev runner overrides this.
SQLITE_PATH=

# First admin account (seeded by scripts/bootstrap.php when no admin exists)
ADMIN_NAME=مدیر چاپخانه
ADMIN_PHONE=
ADMIN_PASSWORD=
